# Template processado pelo nginx:alpine no boot (envsubst sobre /etc/nginx/templates).
#
# O frontend serve os arquivos estaticos E faz proxy para os dois backends,
# espelhando os proxies do Vite em desenvolvimento (/api -> auditor,
# /conc -> conciliador). Tudo na mesma origem => sem CORS em producao.
#
# Variaveis exigidas no ambiente do servico:
#   PORT             injetada pelo Railway
#   AUDITOR_URL      ex.: http://auditor.railway.internal:8000
#   CONCILIADOR_URL  ex.: http://conciliador.railway.internal:8001

# RESOLUCAO DE DNS EM TEMPO DE REQUISICAO
# --------------------------------------
# Com um hostname literal em proxy_pass, o nginx resolve UMA VEZ, no boot, e
# ABORTA se o nome nao resolver naquele instante ("host not found in upstream").
# Isso quebra de duas formas no Railway: se o backend ainda nao subiu, ou se o
# DNS interno demora a responder, o frontend inteiro morre — mesmo servindo
# arquivos estaticos que nao dependem de backend nenhum.
#
# Usar uma VARIAVEL em proxy_pass adia a resolucao para cada requisicao, e ai o
# nginx precisa de um resolver explicito. O NGINX_LOCAL_RESOLVERS vem do proprio
# entrypoint da imagem (15-local-resolvers.envsh, que le o /etc/resolv.conf),
# entao pegamos o DNS do container sem hardcode.
# ipv6=on e obrigatorio: a rede privada do Railway so publica registros AAAA.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;
resolver_timeout 5s;

server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Upload de anexos em PDF/planilha: o padrao do nginx (1M) rejeitaria.
    client_max_body_size 100M;

    proxy_connect_timeout 30s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;

    # Permite que AUDITOR_URL/CONCILIADOR_URL apontem para uma URL https
    # (dominio publico do Railway) e nao so para a rede privada. Sem SNI o
    # handshake TLS falha; sem o Host correto o roteador do Railway nao sabe
    # para qual servico entregar. Isso transforma "trocar de rede privada para
    # publica" numa mudanca de VARIAVEL, sem rebuild.
    proxy_ssl_server_name on;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # AUDITOR — mantem o prefixo /api (as rotas dele ja sao /api/...).
    location /api/ {
        set $upstream_auditor ${AUDITOR_URL};
        proxy_pass $upstream_auditor;
        proxy_set_header Host $proxy_host;   # casa com o upstream (interno ou publico)
    }

    # CONCILIADOR — REMOVE o prefixo /conc: as rotas dele sao /auth/login,
    # /prefeituras...
    #
    # O caminho e capturado na PROPRIA location (conc_rest) em vez de via
    # `rewrite ... break`. Motivo: quando proxy_pass usa variavel e nao traz
    # URI, o nginx repassa a URI ORIGINAL e ignora o rewrite — o conciliador
    # receberia /conc/auth/login e responderia 404. Com a captura, montamos a
    # URI de destino explicitamente.
    location ~ ^/conc/(?<conc_rest>.*)$ {
        set $upstream_conciliador ${CONCILIADOR_URL};
        proxy_pass $upstream_conciliador/$conc_rest$is_args$args;
        proxy_set_header Host $proxy_host;   # casa com o upstream (interno ou publico)
    }

    # Diagnostico: responde sem depender de backend nenhum.
    location = /_saude {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "frontend ok\n";
    }

    # SPA: qualquer rota desconhecida devolve o index para o router do React.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
