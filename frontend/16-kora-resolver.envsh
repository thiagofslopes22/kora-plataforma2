# Sourced pelo entrypoint do nginx ANTES do passo de envsubst (20-...).
#
# Numeracao e extensao importam: o entrypoint processa /docker-entrypoint.d/ em
# ordem alfabetica e SOURCEIA arquivos .envsh (executa os .sh). O 16 garante que
# isto rode depois do 15-local-resolvers.envsh da imagem e antes do 20-envsubst.
#
# ATENCAO: o entrypoint IGNORA arquivos sem bit de execucao ("Ignoring ...,
# not executable"). O chmod +x e feito no Dockerfile, porque o Windows nao
# preserva o modo do arquivo no git.
#
# Objetivo: NGINX_LOCAL_RESOLVERS nunca chegar vazio/indefinido ao template.
# Se chegar, o envsubst deixa o literal `${NGINX_LOCAL_RESOLVERS}` na config e o
# nginx aborta o boot inteiro ("host not found in resolver"), derrubando ate os
# arquivos estaticos, que nao dependem de DNS algum. Nao dependemos do script
# 15- da imagem: na pratica ele nem sempre exporta a variavel.

# `|| true` porque este arquivo e SOURCEADO: com `set -e` ativo no entrypoint,
# um awk que falhe abortaria o boot em vez de cair no fallback.
if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ] && [ -r /etc/resolv.conf ]; then
    NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN { ORS=" " }
        $1 == "nameserver" { if ($2 ~ /:/) print "[" $2 "]"; else print $2 }' \
        /etc/resolv.conf 2>/dev/null) || true
fi

# Ultimo recurso: DNS embutido do runtime de container.
if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
    NGINX_LOCAL_RESOLVERS="127.0.0.11"
fi

export NGINX_LOCAL_RESOLVERS
echo "[kora] resolver DNS para os proxies: ${NGINX_LOCAL_RESOLVERS}"
