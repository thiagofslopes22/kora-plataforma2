# Sourced pelo entrypoint do nginx ANTES do passo de envsubst (20-...).
# Extensao .envsh e o numero 16 importam: o entrypoint SOURCEIA arquivos .envsh
# em ordem numerica, entao isto roda depois do 15-local-resolvers.envsh da
# imagem e antes do 20-envsubst-on-templates.sh.
#
# Objetivo: garantir que NGINX_LOCAL_RESOLVERS NUNCA chegue vazio ao template.
# Se chegar, o envsubst gera `resolver  valid=10s ipv6=on;` (sem endereco) ou
# deixa o literal `${NGINX_LOCAL_RESOLVERS}`, e o nginx ABORTA no boot. O efeito
# e desproporcional: o site inteiro para de subir por causa do DNS de um proxy.

if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
    # Le do resolv.conf do container. Enderecos IPv6 precisam ir entre colchetes
    # na diretiva resolver do nginx.
    NGINX_LOCAL_RESOLVERS=$(awk '/^[[:space:]]*nameserver/ {
        if ($2 ~ /:/) printf "[%s] ", $2; else printf "%s ", $2
    }' /etc/resolv.conf 2>/dev/null)
fi

if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
    # Ultimo recurso: DNS embutido do runtime de container.
    NGINX_LOCAL_RESOLVERS="127.0.0.11"
fi

export NGINX_LOCAL_RESOLVERS
echo "[kora] resolver DNS para os proxies: ${NGINX_LOCAL_RESOLVERS}"
